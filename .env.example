# Supabase — backend pour la landing /landing et le CRM /admin
# Crée un projet free sur https://supabase.com (région EU)
# Récupère ces 2 valeurs dans Project Settings → API
# Copie ce fichier en `.env.local` et remplis tes vraies valeurs

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Mot de passe d'accès au CRM /admin
# Choisis une passphrase longue (24+ caractères, mix lettres/chiffres/symboles).
# Ne jamais commit `.env.local`. Pour changer le mot de passe, modifie ici puis redémarre `npm run dev`.

VITE_ADMIN_PASSWORD=ChangeMeStrongPasswordHere
